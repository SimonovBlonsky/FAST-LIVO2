<launch>

	<arg name="rviz" default="true" />

	<rosparam command="load" file="$(find fast_livo)/config/FusionPortableV2/fusionportablev2_ugv.yaml" />
	<param name="common/img_topic" value="/stereo/frame_left/image_raw" />

	<node pkg="image_transport" type="republish" name="fusionportable_frame_left_republish"
	      args="compressed in:=/stereo/frame_left/image_raw raw out:=/stereo/frame_left/image_raw"
	      output="screen" respawn="true" />

	<node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
		<rosparam file="$(find fast_livo)/config/FusionPortableV2/camera_fusionportablev2_ugv.yaml" />
	</node>
	
	<group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
	</group>
</launch> 	
